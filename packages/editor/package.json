{
  "name": "@agentic-crm/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Rich-text editor (TipTap + Yjs) restricted to Attio's note model, plus the shared block/markdown projection",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "dev": "vite --config dev/vite.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@agentic-crm/ui": "workspace:*",
    "@floating-ui/react": "0.27.20",
    "@hocuspocus/provider": "4.7.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "@vanilla-extract/css": "1.21.2",
    "lucide-react": "1.51.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts"
  }
}
