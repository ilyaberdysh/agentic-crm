{
  "name": "@agentic-crm/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kysely schema, migrations, RLS, seed",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/migrate.ts up",
    "reset": "tsx src/migrate.ts reset",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "@agentic-crm/config": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
