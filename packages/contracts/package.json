{
  "name": "@agentic-crm/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared Zod schemas and Agentic CRM public REST contract",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "generate:v2": "node scripts/generate-v2.ts",
    "check:v2": "node scripts/generate-v2.ts --check"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./product-modules": "./src/product-modules.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/openapi.json": "./src/v2/openapi.gen.json"
  }
}
