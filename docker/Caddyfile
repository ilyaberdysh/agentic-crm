# Web container: TLS ends at Coolify's Traefik; this serves http on :80.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# Presigned S3 URLs point at the web origin (S3_PUBLIC_ENDPOINT) with path-style /<bucket>/<key>; the Host header
	# is passed through unchanged, which the signature covers. SeaweedFS checks the signature (identities in s3.json).
	handle /{$S3_BUCKET:crm-files}/* {
		reverse_proxy s3:8333
	}
	handle /trpc/* {
		reverse_proxy api:4100
	}
	handle /api/* {
		reverse_proxy api:4100
	}
	handle /v2/* {
		reverse_proxy api:4100
	}
	handle /realtime* {
		reverse_proxy api:4100
	}
	handle /collab* {
		reverse_proxy collab:4101
	}

	handle {
		root * /srv
		# Hashed assets are immutable; index.html must always be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
