# Anthropic API key for the AI layer (slice 10). Put the real value only in .env.
ANTHROPIC_API_KEY=
# Google OAuth client (Internal app) for Gmail/Calendar sync (slice 7b). Both empty = "Google is not configured on
# this server" in Settings → Email and calendar accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorised redirect URI registered on the OAuth client. Default: <API_PUBLIC_URL or http://localhost:4100>
# + /api/integrations/google/callback (open the web app at http://localhost:5173 so the session cookie reaches it).
GOOGLE_REDIRECT_URI=
# Optional: only sync mail of the last N days on the first sync (empty = every message that was not deleted).
GOOGLE_MAIL_SYNC_DAYS=
# Key that encrypts OAuth tokens at rest (AES-256-GCM): 32 random bytes as 64 hex chars, e.g. `openssl rand -hex 32`.
# Required in production; in dev a stable key is derived from AUTH_SECRET (a warning is logged). Changing it makes
# every connected Google account ask to reconnect.
AGENTIC_CRM_ENCRYPTION_KEY=

# Answer every AI request from the deterministic fake (e2e, demos without a key): AGENTIC_CRM_LLM=fake
AGENTIC_CRM_LLM=
